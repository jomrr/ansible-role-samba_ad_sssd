# Managed by ansible.
# file: {{ template_destpath }}
{% set __sssd_sections = {
  'sssd': sssd_sssd_options | combine({
    'domains': sssd_realm | lower,
    'services': 'nss, pam'}),
  'domain/' ~ (sssd_realm | lower): sssd_domain_options | combine({
    'id_provider': 'ad',
    'auth_provider': 'ad',
    'ad_domain': sssd_realm | lower,
    'krb5_realm': sssd_realm | upper,
    'ad_hostname': sssd_host_fqdn,
    'krb5_keytab': sssd_keytab,
    'ldap_krb5_keytab': sssd_keytab,
    'ldap_id_mapping': sssd_id_mapping == 'autorid_compat',
    'ldap_idmap_autorid_compat': sssd_id_mapping == 'autorid_compat'}),
  'nss': sssd_nss_options,
  'pam': sssd_pam_options
} %}
{% for __sssd_section, __sssd_options in __sssd_sections.items() %}

[{{ __sssd_section }}]
{% for __sssd_key, __sssd_value in __sssd_options | dictsort %}
{{ __sssd_key }} = {{ (__sssd_value | string | lower) if __sssd_value is boolean else __sssd_value }}
{% endfor %}
{% endfor %}
